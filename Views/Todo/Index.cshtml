@model IEnumerable<ToDoListApp.Models.TodoItem>
@{
    ViewData["Title"] = "TodoItem List";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchDeadline = ViewBag.SearchDeadline ?? "";
}

<div class="container my-4">
    <div class="card shadow-sm p-4 rounded-3" style="background-color: #f8f9fa;">
        <h2 class="fw-bold mb-3">TodoItem List</h2>

        <div class="d-flex align-items-center mb-3 gap-2">
            <a asp-action="Create" class="btn btn-primary fw-bold px-3">+ Add New Task</a>
        </div>

        <form method="get" asp-action="Index" class="row g-2 align-items-center mb-4">
            <div class="col-auto">
                <input type="date" name="searchDeadline" value="@searchDeadline" class="form-control" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary px-4 fw-bold">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered align-middle bg-white">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Deadline</th>
                        <th class="text-center">File</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isUrgent = (item.Deadline - DateTime.Now).TotalHours <= 24 && (item.Deadline - DateTime.Now).TotalHours >= 0;
                        string rowClass = isUrgent ? "table-danger-custom" : "";
                        <tr class="@rowClass">
                            <td class="fw-semibold">@item.Title</td>
                            <td>@item.Description</td>
                            <td>@item.Deadline.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <a asp-action="Download" asp-route-filePath="@item.FilePath" class="btn btn-success btn-sm px-3 fw-bold">Download</a>
                                }
                                else
                                {
                                    <span class="text-muted">No File</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm fw-bold me-1 text-white">Edit</a>
                                <button onclick="confirmDelete(@item.Id)" class="btn btn-danger btn-sm fw-bold">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav class="d-flex justify-content-center mt-3">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchDeadline="@searchDeadline">Previous</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchDeadline="@searchDeadline">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchDeadline="@searchDeadline">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<style>
    .table-danger-custom {
        background-color: #f8d7da !important;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Todo/Delete/' + id,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Deleted!', 'Task has been deleted.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error!', 'Something went wrong.', 'error');
                            }
                        }
                    });
                }
            });
        }
    </script>
}
