@model ToDoListApp.Models.TodoItemEditViewModel
@{
    ViewData["Title"] = "Edit Task";
}

<div class="container my-5" style="max-width: 700px;">
    <div class="card shadow-sm p-4 rounded-3" style="background-color: #f8f9fa;">
        <h2 class="fw-bold mb-4">Edit Task</h2>
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingFilePath" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Deadline" class="form-label fw-bold"></label>
                <input asp-for="Deadline" class="form-control" type="datetime-local" value="@Model.Deadline.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ExistingFilePath))
            {
                <div class="mb-3 p-3 bg-light rounded border">
                    <label class="form-label fw-bold d-block">Current File</label>
                    <a asp-action="Download" asp-route-filePath="@Model.ExistingFilePath" class="text-primary fw-bold">Open / Download Current File</a>
                </div>
            }

            <div class="mb-4">
                <label asp-for="NewFile" class="form-label fw-bold">Upload New File (Optional)</label>
                <input asp-for="NewFile" type="file" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success px-4 fw-bold">Update</button>
                <a asp-action="Index" class="btn btn-secondary px-4 fw-bold">Back</a>
            </div>
        </form>
    </div>
</div>
